POSTGRES_USER=se310
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=se310
# Chỉ backend sử dụng; lấy chuỗi pooled từ Neon Console.
ConnectionStrings__DefaultConnection=Host=ep-example-pooler.region.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-with-neon-password;SSL Mode=VerifyFull
MINIO_ROOT_USER=replace-with-local-user
MINIO_ROOT_PASSWORD=replace-with-local-password
# Bắt buộc, tối thiểu 32 byte ngẫu nhiên. Tạo bằng: openssl rand -base64 48
JWT_SIGNING_KEY=
GOOGLE_CLIENT_ID=
# Để trống toàn bộ SMTP_* => Compose gửi mail vào Mailpit local (http://localhost:8025).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_STARTTLS=true, SMTP_USER=<gmail>,
# SMTP_PASSWORD=<App Password 16 ký tự, KHÔNG dùng mật khẩu Gmail>, SMTP_FROM=QLKLTN <gmail>
SMTP_HOST=
SMTP_PORT=
SMTP_USE_STARTTLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
